# Summer Quest local agent server — server-side only.
# Copy this file to server/agent-proxy/.env and fill only the providers you want to use.
# NEVER copy these keys into js/config.js or the Android/PWA bundle.

# Local/LAN server
SUMMER_HOST=0.0.0.0
SUMMER_PORT=9000
FAMILY_TZ=Asia/Taipei
SUMMER_AGENT_TIMEOUT_MS=10000
SUMMER_AGENT_RATE_LIMIT_PER_MINUTE=60

# Local learning/tutor telemetry collector (server-only storage)
SUMMER_LEARNING_TELEMETRY_LIMIT=5000
SUMMER_LEARNING_TELEMETRY_RATE_LIMIT_PER_MINUTE=300
SUMMER_LEARNING_TELEMETRY_MAX_BODY_BYTES=16000

# Controlled tutor-policy experiments are OFF by default. Enable only when an
# adult/developer intends to collect comparison evidence. Stable assignment is
# per learner; this never changes grading or learning level.
# Supported v0.3.8 experiment: math-near-miss-support-v1
SUMMER_TUTOR_EXPERIMENTS=

# Child-safe default routing. `npm run agent:serve` honors only this profile unless
# SUMMER_AGENT_ALLOWED_PROFILES is explicitly expanded.
SUMMER_AGENT_PROFILE=openai-luna-cheap
SUMMER_AGENT_ALLOWED_PROFILES=openai-luna-cheap
SUMMER_AGENT_ALLOW_PROFILE_OVERRIDE=false
SUMMER_AGENT_ALLOW_DEV_PROFILES=false

# Provider credentials (server only)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional public app/sync config injected into /js/config.js by the local server.
SQ_SUPABASE_URL=
SQ_SUPABASE_ANON_KEY=
SQ_NTFY_TOPIC=
